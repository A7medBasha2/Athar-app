{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and synced preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth User ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Unique user handle without @ prefix",
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "bio": {
          "type": "string",
          "description": "User bio or spiritual intention",
          "maxLength": 300
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo or avatar URL",
          "maxLength": 2048
        },
        "level": {
          "type": "integer",
          "description": "User current spiritual level based on XP"
        },
        "xp": {
          "type": "integer",
          "description": "User earned experience points"
        },
        "streakDays": {
          "type": "integer",
          "description": "Consecutive days streak"
        },
        "isPublicProfile": {
          "type": "boolean",
          "description": "Whether profile statistics can be shared"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp when account was created",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection storing individual user data"
    }
  }
}
