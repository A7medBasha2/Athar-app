{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and synced preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth User ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Unique user handle without @ prefix",
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "bio": {
          "type": "string",
          "description": "User bio or spiritual intention",
          "maxLength": 300
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo or avatar URL",
          "maxLength": 2048
        },
        "level": {
          "type": "integer",
          "description": "User current spiritual level based on XP"
        },
        "xp": {
          "type": "integer",
          "description": "User earned experience points"
        },
        "streakDays": {
          "type": "integer",
          "description": "Consecutive days streak"
        },
        "isPublicProfile": {
          "type": "boolean",
          "description": "Whether profile statistics can be shared"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp when account was created",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        }
      },
      "required": ["uid", "email"]
    },
    "XPLedgerEntry": {
      "title": "XPLedgerEntry",
      "description": "Idempotent, append-only experience points ledger event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "activityType": { "type": "string", "maxLength": 64 },
        "points": { "type": "integer" },
        "label": { "type": "string", "maxLength": 128 },
        "dateKey": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "integer" },
        "details": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "activityType", "points", "label", "dateKey", "timestamp"]
    },
    "EarnedAchievement": {
      "title": "EarnedAchievement",
      "description": "Secure record of unlocked achievement badge",
      "type": "object",
      "properties": {
        "badgeId": { "type": "string", "maxLength": 128 },
        "unlockedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["badgeId", "unlockedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Text-only Islamic reflection or discussion post in Gamaa community",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorPhoto": { "type": "string", "maxLength": 2048 },
        "authorLevel": { "type": "integer" },
        "content": { "type": "string", "minLength": 3, "maxLength": 600 },
        "commentsCount": { "type": "integer" },
        "reactionsCount": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["authorId", "authorName", "content"]
    },
    "CommunityComment": {
      "title": "CommunityComment",
      "description": "Direct response to a Gamaa community post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorPhoto": { "type": "string", "maxLength": 2048 },
        "authorLevel": { "type": "integer" },
        "content": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["postId", "authorId", "authorName", "content"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "User report for inappropriate or violating content in Gamaa community",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["post", "comment"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "enum": ["inappropriate", "offensive", "spam", "other"] },
        "details": { "type": "string", "maxLength": 300 },
        "snippet": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["targetType", "targetId", "reporterId", "reason", "status"]
    },
    "GlobalNotice": {
      "title": "GlobalNotice",
      "description": "Global or scoped in-app announcement banner managed by system owners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 60 },
        "message": { "type": "string", "minLength": 3, "maxLength": 300 },
        "scope": { "type": "string", "enum": ["app_wide", "gamaa", "section"] },
        "targetSection": { "type": "string", "maxLength": 64 },
        "targetCampaignId": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["normal", "high", "urgent"] },
        "isPinned": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "scheduled", "active", "archived"] },
        "startsAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "message", "scope", "priority", "status", "startsAt", "expiresAt", "creatorId"]
    },
    "CommunityGroup": {
      "title": "CommunityGroup",
      "description": "Islamic study circle, reflection, or dhikr gathering group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 3, "maxLength": 60 },
        "description": { "type": "string", "minLength": 5, "maxLength": 300 },
        "category": { "type": "string", "enum": ["quran", "dhikr", "knowledge", "charity", "general"] },
        "isPrivate": { "type": "boolean" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 120 },
        "membersCount": { "type": "integer" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "description", "category", "isPrivate", "creatorId", "membersCount"]
    },
    "CommunityGroupMember": {
      "title": "CommunityGroupMember",
      "description": "Membership record in a community group",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userPhoto": { "type": "string", "maxLength": 2048 },
        "userLevel": { "type": "integer" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "status": { "type": "string", "enum": ["active", "pending"] },
        "joinedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "role", "status"]
    },
    "CommunityGroupPost": {
      "title": "CommunityGroupPost",
      "description": "Isolated spiritual reflection post within a community group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorPhoto": { "type": "string", "maxLength": 2048 },
        "authorLevel": { "type": "integer" },
        "content": { "type": "string", "minLength": 3, "maxLength": 600 },
        "commentsCount": { "type": "integer" },
        "reactionsCount": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "groupId", "authorId", "authorName", "content", "commentsCount", "reactionsCount"]
    },
    "CommunityGroupComment": {
      "title": "CommunityGroupComment",
      "description": "Text comment on a group reflection post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "content": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "groupId", "postId", "authorId", "authorName", "content"]
    },
    "CommunityCampaign": {
      "title": "CommunityCampaign",
      "description": "Public community dhikr and prayer collective campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 100 },
        "description": { "type": "string", "minLength": 5, "maxLength": 500 },
        "targetDhikrPreset": { "type": "string", "enum": ["subhanallah_wabihamdih", "tasbih_tahmid_takbir", "istighfar", "salawat", "la_ilaha_illallah", "hawqala"] },
        "totalTarget": { "type": "integer" },
        "status": { "type": "string", "enum": ["initializing", "shards_verified", "active", "paused", "completed", "archived"] },
        "isOfficial": { "type": "boolean" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "description", "targetDhikrPreset", "totalTarget", "status", "isOfficial", "creatorId"]
    },
    "CampaignShard": {
      "title": "CampaignShard",
      "description": "Counter shard 0-9 for high-throughput distributed incrementing",
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "lastIncrement": { "type": "integer" },
        "lastContributionId": { "type": "string", "maxLength": 128 },
        "lastSequence": { "type": "integer" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["count", "lastIncrement", "lastContributionId", "lastSequence"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection storing individual user data"
    },
    "/users/{userId}/xp_ledger/{eventId}": {
      "schema": "XPLedgerEntry",
      "description": "Append-only idempotent XP ledger events"
    },
    "/users/{userId}/achievements/{badgeId}": {
      "schema": "EarnedAchievement",
      "description": "User unlocked achievements"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Public text posts within Gamaa Islamic community"
    },
    "/community_posts/{postId}/comments/{commentId}": {
      "schema": "CommunityComment",
      "description": "Direct text comments on community posts"
    },
    "/community_campaigns/{campaignId}": {
      "schema": "CommunityCampaign",
      "description": "Public community dhikr campaigns"
    },
    "/community_campaigns/{campaignId}/shards/{shardId}": {
      "schema": "CampaignShard",
      "description": "Distributed counter shards for active campaigns"
    },
    "/community_reports/{reportId}": {
      "schema": "CommunityReport",
      "description": "Community moderation reports submitted by users"
    },
    "/global_notices/{noticeId}": {
      "schema": "GlobalNotice",
      "description": "System in-app broadcast announcements and scoped banners"
    },
    "/community_groups/{groupId}": {
      "schema": "CommunityGroup",
      "description": "Islamic study circles and discussion groups"
    },
    "/community_groups/{groupId}/members/{memberId}": {
      "schema": "CommunityGroupMember",
      "description": "Group membership and approval states"
    },
    "/community_groups/{groupId}/posts/{postId}": {
      "schema": "CommunityGroupPost",
      "description": "Isolated group reflection feed posts"
    },
    "/community_groups/{groupId}/posts/{postId}/comments/{commentId}": {
      "schema": "CommunityGroupComment",
      "description": "Comments on group reflection posts"
    }
  }
}
