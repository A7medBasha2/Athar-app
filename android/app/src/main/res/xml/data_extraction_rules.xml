<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- OWASP MASVS-STORAGE-1: Exclude sensitive databases, tokens and internal storage from cloud backup -->
        <exclude domain="sharedpref" path="AtharFCMPreferences.xml" />
        <exclude domain="sharedpref" path="AtharPrivacyPreferences.xml" />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- OWASP MASVS-STORAGE-1: Exclude sensitive databases and credentials from device-to-device transfer -->
        <exclude domain="sharedpref" path="AtharFCMPreferences.xml" />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
