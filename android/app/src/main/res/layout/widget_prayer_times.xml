<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110A"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: Date and Next Prayer Highlight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="أثر | مواقيت الصلاة"
            android:textColor="#C4B998"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvWidgetRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متبقي ساعتان"
            android:textColor="#E6C66E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Next Prayer Callout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetNextPrayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="صلاة الفجر"
            android:textColor="#FFF2C2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetNextTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:15"
            android:textColor="#E6C66E"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#2E2617" />

    <!-- 5 Prayers Grid Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Fajr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#A89B7A"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetFajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:15"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#A89B7A"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetDhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#A89B7A"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetAsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:15"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#A89B7A"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetMaghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:50"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#A89B7A"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetIsha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:20"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
