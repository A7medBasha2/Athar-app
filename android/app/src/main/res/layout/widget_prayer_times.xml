<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_royal_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: Logo, Hijri Date, Countdown Badge & Quick Refresh -->
    <LinearLayout
        android:id="@+id/widgetHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivWidgetLogo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/icon_logo" />

        <TextView
            android:id="@+id/tvWidgetDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="أَثَرُ | مواقيت الصلاة"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="متبقي: 01:25"
            android:textColor="#FFF2C2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="تحديث"
            android:padding="2dp"
            android:src="@drawable/ic_stat_athar" />
    </LinearLayout>

    <!-- Center Next Prayer Highlight Card (Deep link to Prayers) -->
    <LinearLayout
        android:id="@+id/layoutNextPrayerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_prayer_box_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetNextStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#BFA76A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvWidgetNextPrayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="صلاة الفجر"
                android:textColor="#FFF9E6"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWidgetNextTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:15"
            android:textColor="#E6C66E"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Daily Quranic Verse / Dhikr Section (Deep link to Quran/Adhkar) -->
    <LinearLayout
        android:id="@+id/layoutWidgetAyah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_ayah_box_bg"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/tvWidgetAyahText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="﴿أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ﴾"
            android:textColor="#F3EBDD"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvWidgetAyahSurah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="سورة الرعد - الآية ٢٨"
            android:textColor="#C8A24A"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 5 Prayers Grid Row (Deep link to Prayers) -->
    <LinearLayout
        android:id="@+id/layoutPrayerTimesGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/cellWidgetFajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/lblWidgetFajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#9E9478"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetFajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:15"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/cellWidgetDhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/lblWidgetDhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#9E9478"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetDhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/cellWidgetAsr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/lblWidgetAsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#9E9478"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetAsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:15"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/cellWidgetMaghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/lblWidgetMaghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#9E9478"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetMaghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:50"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/cellWidgetIsha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/lblWidgetIsha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#9E9478"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWidgetIsha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:20"
                android:textColor="#F3E5AB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
