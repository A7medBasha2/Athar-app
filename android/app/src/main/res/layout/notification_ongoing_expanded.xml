<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOngoingNotifExpanded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/royal_overlay_card_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Top Row: Bell Quick Action (Left), Next Prayer & Countdown (Center), Royal Logo (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Quick Action Bell Toggle Button on Left -->
        <ImageButton
            android:id="@+id/btnOngoingBell"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/royal_dark_btn_bg"
            android:contentDescription="تبديل تنبيه الأذان"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bell_active" />

        <!-- Next Prayer Title & Live Countdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOngoingPrayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="الصلاة القادمة: صلاة الفجر"
                    android:textColor="#FFF2C2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOngoingPrayerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="05:15"
                    android:textColor="#E6C66E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOngoingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="متبقي: 01:25 · أثر"
                android:textColor="#C4B998"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Large Icon Frame: Gold Royal "أَثَرُ" Calligraphy Logo on Right -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/royal_logo_frame_bg"
            android:padding="5dp">

            <ImageView
                android:id="@+id/ivOngoingLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="شعار أثر الملكي"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_logo" />
        </FrameLayout>
    </LinearLayout>

    <!-- Royal Gold Divider Accent -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#33D4AF37" />

    <!-- 5 Prayers Full Schedule Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/boxOngoingFajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_prayer_box_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="5dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tvOngoingFajrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#C4B998"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOngoingFajrTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="05:15"
                android:textColor="#FFF2C2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/boxOngoingDhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_prayer_box_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="5dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tvOngoingDhuhrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#C4B998"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOngoingDhuhrTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="12:00"
                android:textColor="#FFF2C2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/boxOngoingAsr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_prayer_box_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="5dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tvOngoingAsrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#C4B998"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOngoingAsrTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="15:15"
                android:textColor="#FFF2C2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/boxOngoingMaghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_prayer_box_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="5dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tvOngoingMaghribName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#C4B998"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOngoingMaghribTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="17:50"
                android:textColor="#FFF2C2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/boxOngoingIsha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_prayer_box_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="5dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tvOngoingIshaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#C4B998"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOngoingIshaTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="19:20"
                android:textColor="#FFF2C2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer Hijri & Status Bar -->
    <TextView
        android:id="@+id/tvOngoingExpandedFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="أَثَرُ · مواقيت الصلاة والأذكار"
        android:textColor="#A69977"
        android:textSize="10sp" />

</LinearLayout>
