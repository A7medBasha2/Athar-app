<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoyalNotifCollapsed"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/royal_overlay_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 1. App Royal Logo Frame (Enlarged to fill golden frame edge-to-edge) -->
    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/royal_logo_frame_bg"
        android:padding="0dp">

        <ImageView
            android:id="@+id/ivNotifLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:contentDescription="شعار أثر الملكي"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_logo" />
    </FrameLayout>

    <!-- 2. Text Content (Badge, Title, and Preview Body) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Top Row: Badge + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNotifBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/royal_badge_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="🕌 أثر"
                android:textColor="#FFF2C2"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotifTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="أثر | تنبيه ملكي"
                android:textColor="#FFF2C2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Row: Body preview -->
        <TextView
            android:id="@+id/tvNotifBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="حي على الصلاة · حي على الفلاح"
            android:textColor="#E8E0CE"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. Explicit Clickable Action Elements for RemoteViews -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Button 1: Audio Control ("إيقاف الصوت") -->
        <TextView
            android:id="@+id/btn_action_primary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/royal_gold_btn_bg"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="إيقاف الصوت ✕"
            android:textColor="#080705"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Button 2: Secondary Deep Link Action ("فتح الآية") -->
        <TextView
            android:id="@+id/btn_action_secondary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/royal_dark_btn_bg"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="فتح الآية 📖"
            android:textColor="#FFF2C2"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
