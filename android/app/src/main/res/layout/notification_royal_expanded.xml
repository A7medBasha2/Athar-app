<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoyalNotifExpanded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/royal_overlay_card_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Top Row: Logo, Badge, Title, Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- 1. App Royal Logo Frame (Expanded to fill golden container with glowing rim) -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/royal_logo_frame_bg"
            android:padding="0dp"
            android:layout_gravity="top">

            <ImageView
                android:id="@+id/ivNotifLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="شعار أثر"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_logo" />
        </FrameLayout>

        <!-- 2. Text Content & Header -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Category Badge + Dismiss Icon -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvNotifBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/royal_badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="🕌 تنبيه أثر الملكي"
                    android:textColor="#FFF2C2"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNotifClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#C4B998"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Title (Gold & Bright) -->
            <TextView
                android:id="@+id/tvNotifTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="حان الآن موعد صلاة الفجر"
                android:textColor="#FFF2C2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Body / Quran Verse / Dhikr (Uthmanic Arabic styling) -->
            <TextView
                android:id="@+id/tvNotifBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:text="الله أكبر · الله أكبر\nحي على الصلاة، حي على الفلاح · الصلاة خير من النوم"
                android:textColor="#E8E0CE"
                android:textSize="13sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Interactive Action Buttons (Mute/Pause/Resume Audio & Open App Screen) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Golden Audio Action Button: Inline Play / Pause / Mute / Resume Toggle -->
        <TextView
            android:id="@+id/btnNotifAudio"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/royal_gold_btn_bg"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="كتم الصوت ✕"
            android:textColor="#080705"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Dark Metallic Open App Screen Button: Deep-link to target screen -->
        <TextView
            android:id="@+id/btnNotifOpen"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/royal_dark_btn_bg"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="الانتقال للشاشة ←"
            android:textColor="#FFF2C2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Royal Gold Accent Line -->
    <View
        android:id="@+id/viewNotifProgress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/royal_gold_progress_bg" />

</LinearLayout>
