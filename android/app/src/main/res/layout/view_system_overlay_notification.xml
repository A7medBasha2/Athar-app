<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSystemOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layoutDirection="rtl"
    android:background="@drawable/royal_overlay_card_bg"
    android:orientation="vertical"
    android:padding="0dp"
    android:elevation="20dp">

    <!-- 1. Top Royal Gold Auto-Dismiss Linear Progress Bar -->
    <View
        android:id="@+id/viewOverlayProgress"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:background="@drawable/royal_gold_progress_bg" />

    <!-- 2. Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Emblem, Badges, Reciter Info, Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Athar Royal Crest Frame -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/royal_logo_frame_bg"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ivOverlayLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="شعار أثر"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_logo" />
            </FrameLayout>

            <!-- Badge & Subtitle Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOverlayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أَثَـر • اقرأ ولو آية في اليوم"
                    android:textColor="#E6C66E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlaySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="تلاوة الشيخ مشاري راشد العفاسي"
                    android:textColor="#A89E88"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Quick Dismiss Button ✕ -->
            <TextView
                android:id="@+id/btnOverlayClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#E6C66E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/royal_dark_btn_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Surah & Ayah reference info -->
        <TextView
            android:id="@+id/tvOverlaySurahInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="سورة الرَّحْمَٰن • الآية 60"
            android:textColor="#E6C66E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Sacred Quranic / Dhikr Center Card (Identical to RoyalNotificationSheet) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/royal_ayah_card_box_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvOverlayBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="﴿ هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ ﴾"
                android:textColor="#FFFDF8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Buttons Row: Open Directly, Mute/Play, Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Primary Golden Action Button (Open Quran / Tasbih / Kinship) -->
            <Button
                android:id="@+id/btnOverlayOpen"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/royal_gold_btn_bg"
                android:elevation="4dp"
                android:paddingHorizontal="14dp"
                android:text="فتح الآية بالمصحف ‹"
                android:textColor="#080705"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Mute / Unmute Button -->
            <Button
                android:id="@+id/btnOverlayMute"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/royal_dark_btn_bg"
                android:paddingHorizontal="12dp"
                android:text="كتم 🔊"
                android:textColor="#FFFDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Stop Button -->
            <Button
                android:id="@+id/btnOverlayStop"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/royal_dark_btn_bg"
                android:paddingHorizontal="12dp"
                android:text="إيقاف"
                android:textColor="#FFFDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
