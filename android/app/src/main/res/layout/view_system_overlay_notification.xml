<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSystemOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="14dp"
    android:background="@drawable/royal_overlay_card_bg"
    android:orientation="vertical"
    android:elevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="top">

        <!-- 1. App Royal Logo Frame (Left / Start) -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/royal_logo_frame_bg"
            android:padding="5dp"
            android:layout_gravity="top">

            <ImageView
                android:id="@+id/ivOverlayLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="شعار أثر"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_logo" />
        </FrameLayout>

        <!-- 2. Text Content & Actions (Right / Center in RTL) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <!-- Category Badge + Dismiss Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvOverlayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/royal_badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="🕌 تنبيه أثر الملكي"
                    android:textColor="#FFF2C2"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnOverlayClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#C4B998"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Title (Gold & Bright) -->
            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="حان الآن موعد صلاة الفجر"
                android:textColor="#FFF2C2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Verse / Body Text (Uthmanic Arabic styling) -->
            <TextView
                android:id="@+id/tvOverlayBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:text="الله أكبر · الله أكبر\nحي على الصلاة، حي على الفلاح · الصلاة خير من النوم"
                android:textColor="#E8E0CE"
                android:textSize="13sp" />

            <!-- Actions: Golden Audio Button & Open App -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Golden Audio Button -->
                <Button
                    android:id="@+id/btnOverlayMute"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/royal_gold_btn_bg"
                    android:elevation="4dp"
                    android:paddingHorizontal="16dp"
                    android:text="كتم الصوت ✕"
                    android:textColor="#080705"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Dark Open App Button -->
                <Button
                    android:id="@+id/btnOverlayOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/royal_dark_btn_bg"
                    android:paddingHorizontal="14dp"
                    android:text="فتح تطبيق أثر"
                    android:textColor="#FFF2C2"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 3. Bottom Royal Gold Progress Line -->
    <View
        android:id="@+id/viewOverlayProgress"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:background="@drawable/royal_gold_progress_bg" />

</LinearLayout>
